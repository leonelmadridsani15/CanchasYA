# --- SUPABASE (PostgreSQL) ---
# obtén: supabase.com -> tu proyecto -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.TU_REF:PASSWORD@db.TU_REF.supabase.co:5432/postgres
DB_SSLMODE=require

# --- DJANGO / VERCEl ---
DJANGO_SECRET_KEY=mi-clave-secreta-super-segura
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,mi-proyecto.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://mi-proyecto.vercel.app

# --- MERCADO PAGO (si aplica) ---
# MERCADOPAGO_ACCESS_TOKEN=

# --- SUPABASE STORAGE (archivos MEDIA / fotos de partidos) ---
# Obtén las claves en: Supabase -> tu proyecto -> Settings -> API
SUPABASE_URL=https://fzaggzcaghwgdrqwelww.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_STORAGE_BUCKET=canchasya-media